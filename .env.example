# Variables para el LLM (OpenCode GO)
LLM_API_KEY=tu_api_key_aqui
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=kimi-k2.6

# Configuracion del retrieval
TOP_K=3

# Modo debug
DEBUG=false

# WhatsApp
WHATSAPP_MODE=fake
META_ACCESS_TOKEN=__PENDIENTE__
META_PHONE_NUMBER_ID=__PENDIENTE__
META_WABA_ID=__PENDIENTE__
META_APP_SECRET=__PENDIENTE__
META_VERIFY_TOKEN=rodrigo_webhook_verify_2024
META_GRAPH_VERSION=v23.0
META_VALIDATE_SIGNATURE=false
PUBLIC_WEBHOOK_URL=https://bot.rodrigorodriguez.com.ar

# Webhook processing mode
# inline = procesa inmediatamente (default)
# async  = solo guarda, el worker procesa despues
WEBHOOK_MODE=inline

# Dominio para el bot
DOMAIN=bot.rodrigorodriguez.com.ar

# API REST /ask
ASK_API_KEY=tu_clave_secreta_para_api
ASK_RATE_LIMIT_REQUESTS=20
ASK_RATE_LIMIT_WINDOW_SECONDS=60

# Paths persistentes (opcional; por defecto se usan paths relativos al proyecto)
# DATA_DIR=data
# DOCS_DIR=data/docs
# CHROMA_DIR=data/chroma
# APP_DB_PATH=data/app.sqlite3
