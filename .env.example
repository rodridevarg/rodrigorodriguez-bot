# Variables para el LLM (OpenCode GO)
LLM_API_KEY=tu_api_key_aqui
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=kimi-k2.6

# Configuracion del retrieval
TOP_K=3

# Modo debug
DEBUG=false

# Branding del bot (parametrizable para multi-cliente)
BOT_NAME=Asistente Virtual
BOT_DESCRIPTION=Asistente automatizado por WhatsApp
CONTACT_PHONE=+54 9 0000 000000
CONTACT_EMAIL=contacto@asistentebot.com.ar
FALLBACK_MESSAGE=No encontré información sobre eso en mi base de conocimiento. Te sugiero contactar para más detalles.

# Nombre de la coleccion en ChromaDB (cambia por cliente para evitar colisiones)
COLLECTION_NAME=bot_docs

# Ruta al prompt del sistema (default: data/system_prompt.txt)
# SYSTEM_PROMPT_PATH=data/system_prompt.txt

# WhatsApp
WHATSAPP_MODE=fake
META_ACCESS_TOKEN=__PENDIENTE__
META_PHONE_NUMBER_ID=__PENDIENTE__
META_WABA_ID=__PENDIENTE__
META_APP_SECRET=__PENDIENTE__
META_VERIFY_TOKEN=webhook_verify_2024
META_GRAPH_VERSION=v23.0
META_VALIDATE_SIGNATURE=false
# NOTA: En modo multi-cliente con webhook-router, la validacion de firma
# se hace en el router central. Las instancias individuales NO validan.
PUBLIC_WEBHOOK_URL=https://bot.asistentebot.com.ar

# Webhook processing mode
# inline = procesa inmediatamente (default)
# async  = solo guarda, el worker procesa despues
WEBHOOK_MODE=inline

# Dominio
DOMAIN=bot.asistentebot.com.ar

# API REST /ask
ASK_API_KEY=tu_clave_secreta_para_api
ASK_RATE_LIMIT_REQUESTS=20
ASK_RATE_LIMIT_WINDOW_SECONDS=60

# Panel de administracion
ADMIN_API_KEY=tu_admin_key_secreta
HANDOFF_TRANSITION_MESSAGE=Estás siendo atendido por un asesor humano. En breve te responderá.

# Paths persistentes (opcional; por defecto se usan paths relativos al proyecto)
# DATA_DIR=data
# DOCS_DIR=data/docs
# CHROMA_DIR=data/chroma
# APP_DB_PATH=data/app.sqlite3
