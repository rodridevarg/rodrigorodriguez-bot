# Template de credenciales para Kling AI
# Copiar este archivo a .env y completar con tus credenciales reales
# NUNCA commitear el archivo .env (ya está en .gitignore)

# Credenciales de Kling AI (ByteDance)
# Las encontrás en tu panel de Kling AI (https://www.klingai.com/)
KLING_ACCESS_KEY=tu_access_key_aqui
KLING_SECRET_KEY=tu_secret_key_aqui

# Configuración opcional
# KLING_BASE_URL=https://api-singapore.klingai.com
