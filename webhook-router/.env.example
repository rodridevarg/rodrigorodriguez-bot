# Webhook Router - Variables de entorno

# Meta (mismos valores que tu App de Meta)
META_VERIFY_TOKEN=tu_verify_token_para_webhook
META_APP_SECRET=tu_app_secret_de_meta
META_VALIDATE_SIGNATURE=true

# Admin API Key (para registrar/desregistrar clientes)
ADMIN_API_KEY=clave_secreta_del_router

# Paths
DATA_DIR=data
DB_PATH=data/router.sqlite3

# Timeout al reenviar a instancias (segundos)
HTTP_TIMEOUT_SECONDS=10
